<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Stocklogic.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="Stocklogic.Views.StartPage"
        x:DataType="vm:StartPageViewModel"
        Background="#F1F8E9">

    <Design.DataContext>
        <vm:StartPageViewModel/>
    </Design.DataContext>

    <!-- Root Grid to allow overlay on top -->
    <Grid>

        <!-- ─── Normal page content ───────────────────────────── -->
        <DockPanel LastChildFill="True">

            <StackPanel DockPanel.Dock="Top" Background="#DCEDC8">
                <StackPanel Orientation="Horizontal" Margin="20,10">
                    <Image Source="/Assets/avalonia-logo.ico"
                           Width="40" Height="40" VerticalAlignment="Center"/>
                    <TextBlock Text="Stocklogic"
                               FontSize="28" FontWeight="Black"
                               VerticalAlignment="Center"
                               Margin="10,0,5,0" Foreground="Black"/>
                    <TextBlock Text="Make your furniture!"
                               FontSize="12" FontWeight="Bold"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,8" Foreground="Black"/>
                </StackPanel>
                <Rectangle Height="6" Fill="#C5E1A5" HorizontalAlignment="Stretch"/>
            </StackPanel>

            <Grid>
                <!-- Start button (centred) -->
                <Button Command="{Binding StartCommand}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="80,25"
                        Background="#DCEDC8"
                        BorderBrush="#263238"
                        BorderThickness="5"
                        CornerRadius="60">
                    <TextBlock Text="Start"
                               FontSize="56" FontWeight="Black" Foreground="Black"/>
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#C5E1A5"/>
                            <Setter Property="BorderBrush" Value="Black"/>
                        </Style>
                    </Button.Styles>
                </Button>

                <!-- Stock Manager link (bottom-right) -->
                <Button Command="{Binding OpenStockManagerCommand}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,20,20"
                        Padding="14,8"
                        Background="Transparent"
                        BorderBrush="#A5D6A7"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TextBlock Text="🔒 Stock Manager"
                               FontSize="12" Foreground="#5D7A4D"/>
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#E8F5E9"/>
                        </Style>
                    </Button.Styles>
                </Button>
            </Grid>

        </DockPanel>

        <!-- ─── Password overlay ─────────────────────────────── -->
        <Grid IsVisible="{Binding IsPasswordOverlayVisible}"
              Background="#88000000">

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    CornerRadius="14"
                    Padding="32,28"
                    Width="320"
                    BoxShadow="0 4 24 0 #44000000">
                <StackPanel Spacing="16">

                    <TextBlock Text="Stock Manager Access"
                               FontSize="17" FontWeight="Bold"
                               Foreground="#1B5E20"
                               HorizontalAlignment="Center"/>

                    <Separator Background="#E0E0E0" Height="1"/>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Password" FontSize="13" Foreground="#555"/>
                        <TextBox Text="{Binding PasswordInput}"
                                 PasswordChar="●"
                                 Watermark="Enter password"
                                 CornerRadius="6"
                                 BorderBrush="#C8E6C9"/>
                    </StackPanel>

                    <!-- Error message -->
                    <TextBlock Text="{Binding PasswordError}"
                               IsVisible="{Binding PasswordError,
                                 Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="#E53935"
                               FontSize="12"
                               HorizontalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Cancel"
                                Command="{Binding CancelPasswordCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Width="116"
                                Padding="0,10" FontSize="13"
                                Background="#F5F5F5" Foreground="#757575"
                                CornerRadius="8"/>
                        <Button Content="Enter"
                                Command="{Binding ConfirmPasswordCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Width="116"
                                Padding="0,10" FontSize="13" FontWeight="SemiBold"
                                Background="#2E7D32" Foreground="White"
                                CornerRadius="8"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
