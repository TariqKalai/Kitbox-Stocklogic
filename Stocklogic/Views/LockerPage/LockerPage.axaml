<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Stocklogic.ViewModels"
             xmlns:models="using:Stocklogic.Models"
             xmlns:conv="using:Stocklogic.Converters"
             x:Class="Stocklogic.Views.LockerPage"
             x:DataType="vm:LockerPageViewModel"
             Background="#F1F8E9">

  <Grid RowDefinitions="Auto,*">

    <!-- Header -->
    <StackPanel Grid.Row="0" Background="#DCEDC8">
      <Grid Margin="20,10">
        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
          <Image Width="30" Height="30" Source="/Assets/avalonia-logo.ico"/>
          <TextBlock Margin="8,0,4,0" VerticalAlignment="Center"
                     FontSize="20" FontWeight="Black" Text="Stocklogic"/>
          <TextBlock Margin="0,0,0,4" VerticalAlignment="Bottom"
                     FontSize="10" FontWeight="Bold" Text="Make your furniture!"/>
        </StackPanel>
      </Grid>
      <Rectangle Height="4" HorizontalAlignment="Stretch" Fill="#C5E1A5"/>
    </StackPanel>

    <!-- Contenu principal : 2 colonnes -->
    <Grid Grid.Row="1" ColumnDefinitions="*,380" Margin="16,12,16,16">

      <!-- ═══════════════════════════════════════════════════════ -->
      <!-- COLONNE GAUCHE : Aperçu visuel du cabinet              -->
      <!-- ═══════════════════════════════════════════════════════ -->
      <Border Grid.Column="0"
              Background="White"
              CornerRadius="14"
              Padding="16"
              Margin="0,0,10,0"
              BoxShadow="0 2 8 0 #22000000">
        <Grid RowDefinitions="Auto,*,Auto">

          <!-- Titre + sous-titre -->
          <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Cabinet Preview"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="#5D7A4D"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Click a locker to edit it"
                       FontSize="11" Foreground="#A5D6A7"
                       HorizontalAlignment="Center" Margin="0,2,0,0"
                       IsVisible="{Binding HasLockers}"/>
          </StackPanel>

          <!-- Zone visuelle -->
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom">

              <!-- État vide -->
              <StackPanel IsVisible="{Binding IsEmpty}"
                          HorizontalAlignment="Center"
                          Spacing="8" Margin="0,40">
                <TextBlock Text="🪵" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock Text="No lockers yet"
                           Foreground="#BDBDBD" FontSize="14"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Configure and add a locker →"
                           Foreground="#BDBDBD" FontSize="12"
                           HorizontalAlignment="Center"/>
              </StackPanel>

              <!-- Cadre du cabinet (visible quand il y a des casiers) -->
              <Border IsVisible="{Binding HasLockers}"
                      BorderBrush="#4E342E"
                      BorderThickness="4,4,4,6"
                      Background="Transparent"
                      HorizontalAlignment="Center"
                      MinWidth="120" MaxWidth="220">

                <!--
                  ListBox : gère la sélection au clic.
                  x:CompileBindings="False" uniquement ici pour SelectedItem (object? vs Locker?).
                  Le DataTemplate à l'intérieur utilise bien les bindings compilés via x:DataType.
                -->
                <ListBox x:CompileBindings="False"
                         ItemsSource="{Binding Lockers}"
                         SelectedItem="{Binding SelectedLocker, Mode=TwoWay}"
                         SelectionMode="Single"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">

                  <!-- Thème personnalisé : bordure verte à la sélection -->
                  <ListBox.ItemContainerTheme>
                    <ControlTheme TargetType="ListBoxItem">
                      <Setter Property="Padding" Value="0"/>
                      <Setter Property="Margin" Value="0"/>
                      <Setter Property="Cursor" Value="Hand"/>
                      <Setter Property="Template">
                        <ControlTemplate>
                          <Border Name="ROOT"
                                  Background="Transparent"
                                  BorderBrush="Transparent"
                                  BorderThickness="2"
                                  CornerRadius="0">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                          </Border>
                        </ControlTemplate>
                      </Setter>
                      <Style Selector="^:selected /template/ Border#ROOT">
                        <Setter Property="BorderBrush" Value="#43A047"/>
                        <Setter Property="Background" Value="#1A43A047"/>
                      </Style>
                      <Style Selector="^:pointerover /template/ Border#ROOT">
                        <Setter Property="BorderBrush" Value="#A5D6A7"/>
                      </Style>
                    </ControlTheme>
                  </ListBox.ItemContainerTheme>

                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Locker">
                      <!-- Un casier — hauteur proportionnelle (×2.5) -->
                      <Border BorderBrush="#4E342E"
                              BorderThickness="0,0,0,3"
                              Height="{Binding Height, Converter={x:Static conv:LockerHeightConverter.Instance}}"
                              Background="{Binding Color, Converter={x:Static conv:PanelColorConverter.Instance}}">
                        <Grid ColumnDefinitions="*,*">

                          <!-- Porte gauche -->
                          <Border Grid.Column="0"
                                  IsVisible="{Binding HasDoors}"
                                  BorderBrush="#4E342E" BorderThickness="0,4,2,4"
                                  Margin="4,4,2,4"
                                  Background="{Binding DoorColor, Converter={x:Static conv:DoorColorConverter.Instance}}"
                                  CornerRadius="1">
                            <Ellipse Width="7" Height="7" Fill="#795548"
                                     HorizontalAlignment="Right" VerticalAlignment="Center"
                                     Margin="0,0,5,0"/>
                          </Border>

                          <!-- Porte droite -->
                          <Border Grid.Column="1"
                                  IsVisible="{Binding HasDoors}"
                                  BorderBrush="#4E342E" BorderThickness="2,4,0,4"
                                  Margin="2,4,4,4"
                                  Background="{Binding DoorColor, Converter={x:Static conv:DoorColorConverter.Instance}}"
                                  CornerRadius="1">
                            <Ellipse Width="7" Height="7" Fill="#795548"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Margin="5,0,0,0"/>
                          </Border>

                          <!-- Casier ouvert (sans portes) : affiche la hauteur -->
                          <Border Grid.Column="0" Grid.ColumnSpan="2"
                                  IsVisible="{Binding !HasDoors}"
                                  Margin="8,0">
                            <TextBlock Text="{Binding Height, StringFormat='{}{0}cm'}"
                                       FontSize="10" Foreground="#8D6E63"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Opacity="0.7"/>
                          </Border>

                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>

                </ListBox>
              </Border>

            </StackPanel>
          </ScrollViewer>

          <!-- Bas du panneau gauche : bouton ajout rapide ou hint d'édition -->
          <Button Grid.Row="2"
                  Content="+ Add locker"
                  Command="{Binding AddLockerCommand}"
                  IsEnabled="{Binding CanAddLocker}"
                  IsVisible="{Binding IsAddMode}"
                  HorizontalAlignment="Stretch"
                  Margin="4,12,4,0"
                  Padding="0,10"
                  FontSize="14"
                  Background="#A5D6A7"
                  Foreground="#1B5E20"
                  CornerRadius="8"
                  FontWeight="SemiBold"/>

          <Border Grid.Row="2"
                  IsVisible="{Binding IsEditMode}"
                  Background="#E8F5E9"
                  CornerRadius="8"
                  Padding="10,8"
                  Margin="4,12,4,0">
            <TextBlock Text="✏️ Editing locker — use the panel →"
                       FontSize="12" Foreground="#388E3C"
                       HorizontalAlignment="Center"/>
          </Border>

        </Grid>
      </Border>

      <!-- ═══════════════════════════════════════════════════════ -->
      <!-- COLONNE DROITE : Formulaire de configuration           -->
      <!-- ═══════════════════════════════════════════════════════ -->
      <Border Grid.Column="1"
              Background="White"
              CornerRadius="14"
              Padding="20"
              BoxShadow="0 2 8 0 #22000000">
        <Grid RowDefinitions="Auto,*,Auto">

          <!-- Titre (change selon le mode) -->
          <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,12">
            <TextBlock Text="{Binding PanelTitle}"
                       FontSize="16" FontWeight="Bold"
                       Foreground="#1B5E20"/>
            <Separator Background="#E0E0E0" Height="1"/>
          </StackPanel>

          <!-- Champs du formulaire -->
          <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="14">

              <!-- Hauteur -->
              <StackPanel Spacing="4">
                <TextBlock Text="Locker Height (cm)" FontSize="13" Foreground="#555"/>
                <ComboBox ItemsSource="{Binding AvailableHeights}"
                          SelectedItem="{Binding SelectedHeight}"
                          HorizontalAlignment="Stretch"
                          CornerRadius="6" BorderBrush="#C8E6C9"/>
              </StackPanel>

              <!-- Couleur des panneaux -->
              <StackPanel Spacing="4">
                <TextBlock Text="Color of Panels" FontSize="13" Foreground="#555"/>
                <ComboBox ItemsSource="{Binding AvailableColors}"
                          SelectedItem="{Binding SelectedColor}"
                          HorizontalAlignment="Stretch"
                          CornerRadius="6" BorderBrush="#C8E6C9"/>
              </StackPanel>

              <!-- Présence de portes -->
              <StackPanel Spacing="4">
                <TextBlock Text="Presence of Doors" FontSize="13" Foreground="#555"/>
                <CheckBox Content="Add doors"
                          IsChecked="{Binding HasDoors}"
                          IsEnabled="{Binding DoorAvailable}"
                          FontSize="13"/>
                <TextBlock Text="(doors not available for width > 62 cm)"
                           IsVisible="{Binding !DoorAvailable}"
                           FontSize="11" Foreground="#EF9A9A"/>
              </StackPanel>

              <!-- Couleur des portes -->
              <StackPanel Spacing="4" IsVisible="{Binding HasDoors}">
                <TextBlock Text="Door Color" FontSize="13" Foreground="#555"/>
                <ComboBox ItemsSource="{Binding AvailableDoorColors}"
                          SelectedItem="{Binding SelectedDoorColor}"
                          HorizontalAlignment="Stretch"
                          CornerRadius="6" BorderBrush="#C8E6C9"/>
              </StackPanel>

              <Separator Background="#E0E0E0" Height="1"/>

              <!-- Couleur des cornières -->
              <StackPanel Spacing="4">
                <TextBlock Text="Angle Iron Color" FontSize="13" Foreground="#555"/>
                <ComboBox ItemsSource="{Binding AngleIronColors}"
                          SelectedItem="{Binding SelectedAngleIronColor}"
                          HorizontalAlignment="Stretch"
                          CornerRadius="6" BorderBrush="#C8E6C9"/>
              </StackPanel>

              <!-- Résumé du cabinet -->
              <Border Background="#F1F8E9" CornerRadius="8" Padding="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="Overview" FontWeight="SemiBold"
                             FontSize="13" Foreground="#33691E"/>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Depth:" FontSize="12" Foreground="#555"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Cabinet.Depth, StringFormat='{}{0} cm'}"
                               FontSize="12" FontWeight="Medium"/>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Width:" FontSize="12" Foreground="#555"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Cabinet.Width, StringFormat='{}{0} cm'}"
                               FontSize="12" FontWeight="Medium"/>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Lockers:" FontSize="12" Foreground="#555"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding TotalItemsCount, StringFormat='{}{0} / 7'}"
                               FontSize="12" FontWeight="Medium"/>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasLockers}">
                    <TextBlock Grid.Column="0" Text="Angle iron:" FontSize="12" Foreground="#555"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding AngleIronHeight, StringFormat='{}{0} cm'}"
                               FontSize="12" FontWeight="Medium"/>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- Message d'erreur / status -->
              <TextBlock Text="{Binding StatusMessage}"
                         IsVisible="{Binding StatusMessage,
                           Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         Foreground="#E53935" FontSize="12" TextWrapping="Wrap"/>

            </StackPanel>
          </ScrollViewer>

          <!-- Boutons d'action -->
          <StackPanel Grid.Row="2" Spacing="6" Margin="0,12,0,0">

            <!-- Mode AJOUT -->
            <StackPanel IsVisible="{Binding IsAddMode}" Spacing="6">
              <Button Content="Add locker"
                      Command="{Binding AddLockerCommand}"
                      IsEnabled="{Binding CanAddLocker}"
                      HorizontalAlignment="Stretch"
                      Padding="0,10" FontSize="14" FontWeight="SemiBold"
                      Background="#A5D6A7" Foreground="#1B5E20" CornerRadius="8"/>
              <Button Content="Continue →"
                      Command="{Binding ContinueCommand}"
                      HorizontalAlignment="Stretch"
                      Padding="0,12" FontSize="15" FontWeight="SemiBold"
                      Background="#2E7D32" Foreground="White" CornerRadius="8"/>
              <Button Content="← Back"
                      Command="{Binding BackCommand}"
                      HorizontalAlignment="Stretch"
                      Padding="0,8" FontSize="13"
                      Background="#E8F5E9" Foreground="#388E3C"
                      CornerRadius="8" BorderBrush="#A5D6A7"/>
            </StackPanel>

            <!-- Mode ÉDITION -->
            <StackPanel IsVisible="{Binding IsEditMode}" Spacing="6">
              <Button Content="✔ Update locker"
                      Command="{Binding UpdateLockerCommand}"
                      HorizontalAlignment="Stretch"
                      Padding="0,12" FontSize="14" FontWeight="SemiBold"
                      Background="#2E7D32" Foreground="White" CornerRadius="8"/>
              <Button Content="🗑 Delete locker"
                      Command="{Binding DeleteSelectedLockerCommand}"
                      HorizontalAlignment="Stretch"
                      Padding="0,10" FontSize="13" FontWeight="SemiBold"
                      Background="#FFEBEE" Foreground="#C62828" CornerRadius="8"
                      BorderBrush="#FFCDD2"/>
              <Button Content="✕ Cancel edit"
                      Command="{Binding CancelEditCommand}"
                      HorizontalAlignment="Stretch"
                      Padding="0,8" FontSize="13"
                      Background="#F5F5F5" Foreground="#757575" CornerRadius="8"/>
            </StackPanel>

          </StackPanel>

        </Grid>
      </Border>

    </Grid>
  </Grid>

</UserControl>
