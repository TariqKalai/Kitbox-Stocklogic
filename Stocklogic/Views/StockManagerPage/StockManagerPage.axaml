<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Stocklogic.ViewModels"
             xmlns:models="using:Stocklogic.Models"
             xmlns:conv="using:Stocklogic.Converters"
             x:Class="Stocklogic.Views.StockManagerPage"
             x:DataType="vm:StockManagerPageViewModel"
             Background="#F1F8E9">

  <Grid RowDefinitions="Auto,Auto,*">

    <!-- Header -->
    <StackPanel Grid.Row="0" Background="#DCEDC8">
      <Grid Margin="20,10">
        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
          <Image Width="30" Height="30" Source="/Assets/avalonia-logo.ico"/>
          <TextBlock Margin="8,0,4,0" VerticalAlignment="Center"
                     FontSize="20" FontWeight="Black" Text="Stocklogic"/>
          <TextBlock Margin="0,0,0,4" VerticalAlignment="Bottom"
                     FontSize="10" FontWeight="Bold" Text="Make your furniture!"/>
        </StackPanel>
        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                   FontSize="13" FontWeight="SemiBold"
                   Foreground="#33691E" Text="Stock Manager"/>
      </Grid>
      <Rectangle Height="4" HorizontalAlignment="Stretch" Fill="#C5E1A5"/>
    </StackPanel>

    <!-- Tab buttons -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="0"
                Background="#DCEDC8" Margin="16,0,0,0">
      <Button Content="📦  Parts"
              Command="{Binding SetTabCommand}" CommandParameter="Parts"
              Padding="22,10" FontSize="13" FontWeight="SemiBold"
              CornerRadius="8,8,0,0"
              Background="{Binding IsTabParts, Converter={x:Static conv:BoolToBrushConverter.Instance},
                           ConverterParameter='#FFFFFF|#C5E1A5'}"
              Foreground="{Binding IsTabParts, Converter={x:Static conv:BoolToBrushConverter.Instance},
                           ConverterParameter='#1B5E20|#5D7A4D'}"
              BorderThickness="0"/>
      <Button Content="🧾  Orders"
              Command="{Binding SetTabCommand}" CommandParameter="Orders"
              Padding="22,10" FontSize="13" FontWeight="SemiBold"
              CornerRadius="8,8,0,0"
              Background="{Binding IsTabOrders, Converter={x:Static conv:BoolToBrushConverter.Instance},
                           ConverterParameter='#FFFFFF|#C5E1A5'}"
              Foreground="{Binding IsTabOrders, Converter={x:Static conv:BoolToBrushConverter.Instance},
                           ConverterParameter='#1B5E20|#5D7A4D'}"
              BorderThickness="0"/>
    </StackPanel>

    <!-- Content area -->
    <Grid Grid.Row="2" Margin="16,12,16,16">

      <!-- ══════════════════════════════════════════════════════════ -->
      <!-- TAB : PARTS                                               -->
      <!-- ══════════════════════════════════════════════════════════ -->
      <Grid IsVisible="{Binding IsTabParts}" ColumnDefinitions="*,380">

        <!-- Left : parts list -->
        <Border Grid.Column="0"
                Background="White" CornerRadius="14"
                Padding="16" Margin="0,0,10,0"
                BoxShadow="0 2 8 0 #22000000">
          <Grid RowDefinitions="Auto,Auto,*,Auto">

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
              <TextBlock Text="Parts Stock" FontSize="14" FontWeight="SemiBold"
                         Foreground="#5D7A4D" HorizontalAlignment="Center"/>
              <Separator Background="#E0E0E0" Height="1" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Filter buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,10">
              <Button Content="All"
                      Command="{Binding SetFilterCommand}" CommandParameter="All"
                      Padding="14,6" FontSize="12" CornerRadius="6"
                      Background="{Binding IsFilterAll, Converter={x:Static conv:BoolToBrushConverter.Instance},
                                   ConverterParameter='#A5D6A7|#F1F8E9'}"
                      Foreground="{Binding IsFilterAll, Converter={x:Static conv:BoolToBrushConverter.Instance},
                                   ConverterParameter='#1B5E20|#555555'}"
                      BorderBrush="#C8E6C9"/>
              <Button Content="Low stock"
                      Command="{Binding SetFilterCommand}" CommandParameter="Low"
                      Padding="14,6" FontSize="12" CornerRadius="6"
                      Background="{Binding IsFilterLow, Converter={x:Static conv:BoolToBrushConverter.Instance},
                                   ConverterParameter='#FFE082|#FFF8E1'}"
                      Foreground="{Binding IsFilterLow, Converter={x:Static conv:BoolToBrushConverter.Instance},
                                   ConverterParameter='#E65100|#888888'}"
                      BorderBrush="#FFE082"/>
              <Button Content="Out of stock"
                      Command="{Binding SetFilterCommand}" CommandParameter="Out"
                      Padding="14,6" FontSize="12" CornerRadius="6"
                      Background="{Binding IsFilterOut, Converter={x:Static conv:BoolToBrushConverter.Instance},
                                   ConverterParameter='#EF9A9A|#FFEBEE'}"
                      Foreground="{Binding IsFilterOut, Converter={x:Static conv:BoolToBrushConverter.Instance},
                                   ConverterParameter='#B71C1C|#888888'}"
                      BorderBrush="#FFCDD2"/>
            </StackPanel>

            <!-- Parts list -->
            <ScrollViewer Grid.Row="2">
              <ListBox x:CompileBindings="False"
                       ItemsSource="{Binding FilteredParts}"
                       SelectedItem="{Binding SelectedPart, Mode=TwoWay}"
                       Background="Transparent" BorderThickness="0" Padding="0"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerTheme>
                  <ControlTheme TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,2"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                      <ControlTemplate>
                        <Border Name="ROOT" CornerRadius="6"
                                Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="2">
                          <ContentPresenter Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Border>
                      </ControlTemplate>
                    </Setter>
                    <Style Selector="^:selected /template/ Border#ROOT">
                      <Setter Property="BorderBrush" Value="#43A047"/>
                      <Setter Property="Background"  Value="#1A43A047"/>
                    </Style>
                    <Style Selector="^:pointerover /template/ Border#ROOT">
                      <Setter Property="BorderBrush" Value="#A5D6A7"/>
                    </Style>
                  </ControlTheme>
                </ListBox.ItemContainerTheme>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="models:Part">
                    <Border Padding="10,8" CornerRadius="6"
                            Background="{Binding Status,
                              Converter={x:Static conv:StockStatusColorConverter.Instance}}">
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Grid.Column="0" Spacing="1">
                          <TextBlock Text="{Binding Kind}"
                                     FontSize="13" FontWeight="SemiBold" Foreground="#333"/>
                          <TextBlock FontSize="11" Foreground="#888">
                            <TextBlock.Text>
                              <MultiBinding StringFormat="{}{0}  H:{1}">
                                <Binding Path="Color"/>
                                <Binding Path="Height"/>
                              </MultiBinding>
                            </TextBlock.Text>
                          </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0" HorizontalAlignment="Center">
                          <TextBlock Text="In stock" FontSize="10" Foreground="#888" HorizontalAlignment="Center"/>
                          <TextBlock Text="{Binding InStock}"
                                     FontSize="14" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                          <TextBlock Text="Min" FontSize="10" Foreground="#888" HorizontalAlignment="Center"/>
                          <TextBlock Text="{Binding MinStock}"
                                     FontSize="14" FontWeight="Medium" Foreground="#888" HorizontalAlignment="Center"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </ScrollViewer>

            <Button Grid.Row="3" Content="← Back"
                    Command="{Binding BackCommand}"
                    HorizontalAlignment="Stretch"
                    Margin="0,12,0,0" Padding="0,10" FontSize="13"
                    Background="#E8F5E9" Foreground="#388E3C"
                    CornerRadius="8" BorderBrush="#A5D6A7"/>
          </Grid>
        </Border>

        <!-- Right : part detail -->
        <Border Grid.Column="1"
                Background="White" CornerRadius="14"
                Padding="20" BoxShadow="0 2 8 0 #22000000">
          <Grid RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,12">
              <TextBlock Text="Part Details" FontSize="16" FontWeight="Bold" Foreground="#1B5E20"/>
              <Separator Background="#E0E0E0" Height="1"/>
            </StackPanel>
            <StackPanel Grid.Row="1" IsVisible="{Binding !HasSelectedPart}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
              <TextBlock Text="🗂️" FontSize="40" HorizontalAlignment="Center"/>
              <TextBlock Text="Select a part to see details"
                         Foreground="#BDBDBD" FontSize="13" HorizontalAlignment="Center"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" IsVisible="{Binding HasSelectedPart}">
              <StackPanel Spacing="14">
                <Border Background="#F1F8E9" CornerRadius="8" Padding="12,8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding SelectedPart.Kind}"
                               FontSize="16" FontWeight="Bold" Foreground="#1B5E20"/>
                    <TextBlock FontSize="12" Foreground="#555">
                      <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0}  –  H:{1} cm">
                          <Binding Path="SelectedPart.Color"/>
                          <Binding Path="SelectedPart.Height"/>
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                  </StackPanel>
                </Border>
                <StackPanel Spacing="4">
                  <TextBlock Text="Current stock quantity" FontSize="13" Foreground="#555"/>
                  <Grid ColumnDefinitions="*,Auto">
                    <NumericUpDown Grid.Column="0" Value="{Binding EditStock}"
                                   Minimum="0" Increment="1"
                                   CornerRadius="6" BorderBrush="#C8E6C9" Margin="0,0,6,0"/>
                    <Button Grid.Column="1" Content="Save"
                            Command="{Binding SaveStockCommand}"
                            Padding="14,0" FontSize="13" FontWeight="SemiBold"
                            Background="#A5D6A7" Foreground="#1B5E20" CornerRadius="6"/>
                  </Grid>
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="Minimum stock threshold" FontSize="13" Foreground="#555"/>
                  <Grid ColumnDefinitions="*,Auto">
                    <NumericUpDown Grid.Column="0" Value="{Binding EditMinStock}"
                                   Minimum="0" Increment="1"
                                   CornerRadius="6" BorderBrush="#C8E6C9" Margin="0,0,6,0"/>
                    <Button Grid.Column="1" Content="Save"
                            Command="{Binding SaveMinStockCommand}"
                            Padding="14,0" FontSize="13" FontWeight="SemiBold"
                            Background="#A5D6A7" Foreground="#1B5E20" CornerRadius="6"/>
                  </Grid>
                </StackPanel>
                <TextBlock Text="{Binding SaveMessage}"
                           IsVisible="{Binding SaveMessage,
                             Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="#388E3C" FontSize="12"/>
                <Separator Background="#E0E0E0" Height="1"/>
                <StackPanel Spacing="6">
                  <TextBlock Text="Suppliers" FontSize="13" FontWeight="SemiBold" Foreground="#555"/>
                  <TextBlock Text="No suppliers found for this part."
                             IsVisible="{Binding Suppliers.Count,
                               Converter={x:Static conv:ZeroToBoolConverter.Instance}}"
                             FontSize="12" Foreground="#BDBDBD"/>
                  <Border IsVisible="{Binding RecommendedSupplier,
                                      Converter={x:Static ObjectConverters.IsNotNull}}"
                          Background="#E8F5E9" CornerRadius="8" Padding="10,8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="⭐ Recommended" FontSize="10"
                                   Foreground="#388E3C" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RecommendedSupplier.Name}"
                                   FontSize="13" FontWeight="Bold" Foreground="#1B5E20"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                        <TextBlock Text="{Binding RecommendedSupplier.Price, StringFormat='€{0:F2}'}"
                                   FontSize="13" FontWeight="Bold" Foreground="#2E7D32"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding RecommendedSupplier.DeliveryDays, StringFormat='{}{0} days'}"
                                   FontSize="11" Foreground="#888" HorizontalAlignment="Right"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <ItemsControl ItemsSource="{Binding Suppliers}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:Supplier">
                        <Border Margin="0,2" Padding="10,7"
                                Background="#FAFAFA" CornerRadius="6"
                                BorderBrush="#E0E0E0" BorderThickness="1">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                       FontSize="12" Foreground="#444" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="1">
                              <TextBlock Text="{Binding Price, StringFormat='€{0:F2}'}"
                                         FontSize="12" FontWeight="Medium" Foreground="#333"
                                         HorizontalAlignment="Right"/>
                              <TextBlock Text="{Binding DeliveryDays, StringFormat='{}{0} days'}"
                                         FontSize="11" Foreground="#888" HorizontalAlignment="Right"/>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>

      </Grid>

      <!-- ══════════════════════════════════════════════════════════ -->
      <!-- TAB : ORDERS                                              -->
      <!-- ══════════════════════════════════════════════════════════ -->
      <Grid IsVisible="{Binding IsTabOrders}" ColumnDefinitions="*,380">

        <!-- Left : orders list -->
        <Border Grid.Column="0"
                Background="White" CornerRadius="14"
                Padding="16" Margin="0,0,10,0"
                BoxShadow="0 2 8 0 #22000000">
          <Grid RowDefinitions="Auto,Auto,*,Auto">

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
              <TextBlock Text="Customer Orders" FontSize="14" FontWeight="SemiBold"
                         Foreground="#5D7A4D" HorizontalAlignment="Center"/>
              <Separator Background="#E0E0E0" Height="1" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Order filter buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,10">
              <Button Content="All"
                      Command="{Binding SetOrderFilterCommand}" CommandParameter="All"
                      Padding="14,6" FontSize="12" CornerRadius="6"
                      Background="{Binding IsOrderFilterAll, Converter={x:Static conv:BoolToBrushConverter.Instance},
                                   ConverterParameter='#A5D6A7|#F1F8E9'}"
                      Foreground="{Binding IsOrderFilterAll, Converter={x:Static conv:BoolToBrushConverter.Instance},
                                   ConverterParameter='#1B5E20|#555555'}"
                      BorderBrush="#C8E6C9"/>
              <Button Content="Pending"
                      Command="{Binding SetOrderFilterCommand}" CommandParameter="Pending"
                      Padding="14,6" FontSize="12" CornerRadius="6"
                      Background="{Binding IsOrderFilterPending, Converter={x:Static conv:BoolToBrushConverter.Instance},
                                   ConverterParameter='#FFE082|#FFF8E1'}"
                      Foreground="{Binding IsOrderFilterPending, Converter={x:Static conv:BoolToBrushConverter.Instance},
                                   ConverterParameter='#E65100|#888888'}"
                      BorderBrush="#FFE082"/>
              <Button Content="Ready"
                      Command="{Binding SetOrderFilterCommand}" CommandParameter="Ready"
                      Padding="14,6" FontSize="12" CornerRadius="6"
                      Background="{Binding IsOrderFilterReady, Converter={x:Static conv:BoolToBrushConverter.Instance},
                                   ConverterParameter='#A5D6A7|#F1F8E9'}"
                      Foreground="{Binding IsOrderFilterReady, Converter={x:Static conv:BoolToBrushConverter.Instance},
                                   ConverterParameter='#1B5E20|#555555'}"
                      BorderBrush="#C8E6C9"/>
              <Button Content="Completed"
                      Command="{Binding SetOrderFilterCommand}" CommandParameter="Completed"
                      Padding="14,6" FontSize="12" CornerRadius="6"
                      Background="{Binding IsOrderFilterCompleted, Converter={x:Static conv:BoolToBrushConverter.Instance},
                                   ConverterParameter='#B0BEC5|#ECEFF1'}"
                      Foreground="{Binding IsOrderFilterCompleted, Converter={x:Static conv:BoolToBrushConverter.Instance},
                                   ConverterParameter='#37474F|#888888'}"
                      BorderBrush="#B0BEC5"/>
            </StackPanel>

            <!-- Orders list -->
            <ScrollViewer Grid.Row="2">
              <ListBox x:CompileBindings="False"
                       ItemsSource="{Binding FilteredOrders}"
                       SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                       Background="Transparent" BorderThickness="0" Padding="0"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerTheme>
                  <ControlTheme TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,2"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                      <ControlTemplate>
                        <Border Name="ROOT" CornerRadius="6"
                                Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="2">
                          <ContentPresenter Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Border>
                      </ControlTemplate>
                    </Setter>
                    <Style Selector="^:selected /template/ Border#ROOT">
                      <Setter Property="BorderBrush" Value="#43A047"/>
                      <Setter Property="Background"  Value="#1A43A047"/>
                    </Style>
                    <Style Selector="^:pointerover /template/ Border#ROOT">
                      <Setter Property="BorderBrush" Value="#A5D6A7"/>
                    </Style>
                  </ControlTheme>
                </ListBox.ItemContainerTheme>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="models:CustomerOrder">
                    <Border Padding="10,8" CornerRadius="6"
                            Background="{Binding Status,
                              Converter={x:Static conv:OrderStatusColorConverter.Instance}}">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                          <TextBlock Text="{Binding Email}"
                                     FontSize="13" FontWeight="SemiBold" Foreground="#333"/>
                          <TextBlock Text="{Binding Date, StringFormat='{}{0:dd/MM/yyyy}'}"
                                     FontSize="11" Foreground="#888"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                          <TextBlock Text="{Binding StatusLabel}"
                                     FontSize="11" FontWeight="SemiBold"
                                     Foreground="{Binding Status,
                                       Converter={x:Static conv:OrderStatusTextColorConverter.Instance}}"
                                     HorizontalAlignment="Right"/>
                          <TextBlock Text="{Binding TotalPrice, StringFormat='€{0:F2}'}"
                                     FontSize="12" Foreground="#555" HorizontalAlignment="Right"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </ScrollViewer>

            <Button Grid.Row="3" Content="← Back"
                    Command="{Binding BackCommand}"
                    HorizontalAlignment="Stretch"
                    Margin="0,12,0,0" Padding="0,10" FontSize="13"
                    Background="#E8F5E9" Foreground="#388E3C"
                    CornerRadius="8" BorderBrush="#A5D6A7"/>
          </Grid>
        </Border>

        <!-- Right : order detail -->
        <Border Grid.Column="1"
                Background="White" CornerRadius="14"
                Padding="20" BoxShadow="0 2 8 0 #22000000">
          <Grid RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,12">
              <TextBlock Text="Order Details" FontSize="16" FontWeight="Bold" Foreground="#1B5E20"/>
              <Separator Background="#E0E0E0" Height="1"/>
            </StackPanel>

            <!-- Empty state -->
            <StackPanel Grid.Row="1" IsVisible="{Binding !HasSelectedOrder}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
              <TextBlock Text="🧾" FontSize="40" HorizontalAlignment="Center"/>
              <TextBlock Text="Select an order to see details"
                         Foreground="#BDBDBD" FontSize="13" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Detail -->
            <StackPanel Grid.Row="1" IsVisible="{Binding HasSelectedOrder}" Spacing="12">

              <!-- Status badge -->
              <Border CornerRadius="8" Padding="12,8"
                      Background="{Binding SelectedOrder.Status,
                        Converter={x:Static conv:OrderStatusColorConverter.Instance}}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding SelectedOrder.Email}"
                               FontSize="15" FontWeight="Bold" Foreground="#1B5E20"/>
                    <TextBlock Text="{Binding SelectedOrder.Date, StringFormat='{}{0:dd/MM/yyyy}'}"
                               FontSize="12" Foreground="#555"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1"
                             Text="{Binding SelectedOrder.StatusLabel}"
                             FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                             Foreground="{Binding SelectedOrder.Status,
                               Converter={x:Static conv:OrderStatusTextColorConverter.Instance}}"/>
                </Grid>
              </Border>

              <!-- Financials -->
              <Border Background="#F1F8E9" CornerRadius="8" Padding="12">
                <StackPanel Spacing="6">
                  <TextBlock Text="Order Summary" FontWeight="SemiBold"
                             FontSize="13" Foreground="#33691E"/>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Total price:" FontSize="12" Foreground="#555"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding SelectedOrder.TotalPrice, StringFormat='€{0:F2}'}"
                               FontSize="12" FontWeight="Medium"/>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Deposit paid:" FontSize="12" Foreground="#555"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding SelectedOrder.Deposit, StringFormat='€{0:F2}'}"
                               FontSize="12" FontWeight="Medium"/>
                  </Grid>
                  <Separator Background="#C8E6C9" Height="1"/>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Balance due:" FontSize="13"
                               FontWeight="SemiBold" Foreground="#1B5E20"/>
                    <TextBlock Grid.Column="1" FontSize="13" FontWeight="Bold" Foreground="#1B5E20">
                      <TextBlock.Text>
                        <MultiBinding StringFormat="€{0:F2}">
                          <Binding Path="SelectedOrder.TotalPrice"/>
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                  </Grid>
                </StackPanel>
              </Border>

              <Separator Background="#E0E0E0" Height="1"/>

              <!-- Status actions -->
              <StackPanel Spacing="6">
                <TextBlock Text="Update Status" FontSize="13" FontWeight="SemiBold" Foreground="#555"/>

                <Button Content="✔ Mark as Ready"
                        Command="{Binding MarkReadyCommand}"
                        IsEnabled="{Binding CanMarkReady}"
                        HorizontalAlignment="Stretch"
                        Padding="0,10" FontSize="13" FontWeight="SemiBold"
                        Background="#A5D6A7" Foreground="#1B5E20" CornerRadius="8"/>

                <Button Content="✔ Mark as Completed"
                        Command="{Binding MarkCompletedCommand}"
                        IsEnabled="{Binding CanMarkCompleted}"
                        HorizontalAlignment="Stretch"
                        Padding="0,10" FontSize="13" FontWeight="SemiBold"
                        Background="#2E7D32" Foreground="White" CornerRadius="8"/>

                <TextBlock Text="{Binding OrderSaveMessage}"
                           IsVisible="{Binding OrderSaveMessage,
                             Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="#388E3C" FontSize="12"/>
              </StackPanel>

            </StackPanel>
          </Grid>
        </Border>

      </Grid>

    </Grid>
  </Grid>

</UserControl>
