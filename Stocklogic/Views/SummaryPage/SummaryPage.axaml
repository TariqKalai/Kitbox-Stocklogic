<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Stocklogic.ViewModels"
             xmlns:models="using:Stocklogic.Models"
             x:Class="Stocklogic.Views.SummaryPage"
             x:DataType="vm:SummaryPageViewModel"
             Background="#F1F8E9">

  <DockPanel LastChildFill="True">

    <Border Height="60"
            Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
      <StackPanel Margin="0,0,20,0"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Orientation="Horizontal">
        <Button Content="Continue Shopping"
                Command="{Binding ContinueShoppingCommand}"
                Margin="0,0,20,0"
                Background="Transparent"
                FontWeight="Bold"
                Foreground="Black" />
        <Button Content="Pay"
                Command="{Binding PayCommand}"
                Background="#4CAF50"
                CornerRadius="5"
                Foreground="White"
                Padding="30,10" />
      </StackPanel>
    </Border>

    <ScrollViewer Margin="40">
      <StackPanel Spacing="20">

        <TextBlock Text="Order Review"
                   FontSize="32"
                   FontWeight="Black"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <ItemsControl ItemsSource="{Binding AllOrders}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:CabinetOrder">
              <Border Background="White"
                      Margin="0,0,0,16"
                      Padding="20"
                      CornerRadius="10"
                      BoxShadow="0 2 5 0 #20000000">
                <StackPanel Spacing="8">

                  <TextBlock FontWeight="Bold" FontSize="16"
                             Text="{Binding Cabinet.Width, StringFormat='Cabinet — Width: {0} cm'}"/>
                  <TextBlock Foreground="Gray"
                             Text="{Binding Cabinet.Depth, StringFormat='Depth: {0} cm'}"/>
                  <TextBlock Foreground="Gray"
                             Text="{Binding Cabinet.AngleIronColor, StringFormat='Angle Iron: {0}'}"/>

                  <Separator Height="1" Background="#E0E0E0" Margin="0,4"/>

                  <TextBlock Text="Lockers" FontSize="14" FontWeight="Bold"/>

                  <ItemsControl ItemsSource="{Binding Lockers}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:Locker">
                        <Border Background="#F9FBF7"
                                Margin="0,4"
                                Padding="12,8"
                                CornerRadius="6">
                          <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Height, StringFormat='Height: {0} cm'}"
                                       FontSize="12" Foreground="Gray"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Foreground="#2E7D32" FontWeight="Bold"
                             Text="{Binding Lockers.Count, StringFormat='Total lockers: {0}'}"/>

                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
