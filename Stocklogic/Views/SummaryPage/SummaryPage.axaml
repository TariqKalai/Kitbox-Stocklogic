<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Stocklogic.ViewModels"
             xmlns:models="using:Stocklogic.Models"
             x:Class="Stocklogic.Views.SummaryPage"
             x:DataType="vm:SummaryPageViewModel"
             Background="#F1F8E9"
             xmlns:conv="using:Stocklogic.Converters">

  <DockPanel LastChildFill="True">
    <Border Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom"
            Padding="20,12">
      <Grid ColumnDefinitions="*,Auto">

        <!-- Left: total price -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="Total" FontSize="12" Foreground="#888"/>
          <TextBlock Text="{Binding TotalPrice, StringFormat='€{0:F2}'}"
                     FontSize="22" FontWeight="Black" Foreground="#2E7D32"/>
          <TextBlock Text="{Binding DepositAmount, StringFormat='Deposit due now (30%): €{0:F2} — rest on pickup'}"
                     IsVisible="{Binding IsDepositNeeded}"
                     FontSize="12" FontWeight="Bold" Foreground="#D32F2F"/>
          <TextBlock Text="All parts in stock — pay in full now"
                     IsVisible="{Binding !IsDepositNeeded}"
                     FontSize="12" Foreground="#2E7D32"/>
        </StackPanel>

        <!-- Right: email + actions -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="{Binding PayMessage}"
                     IsVisible="{Binding PayMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     VerticalAlignment="Center"
                     Foreground="#D32F2F" FontSize="12"/>
          <TextBox Text="{Binding Email}"
                   Watermark="Your email"
                   Width="220"
                   VerticalAlignment="Center"/>
          <Button Content="Continue Shopping"
                  Command="{Binding ContinueShoppingCommand}"
                  Background="Transparent"
                  FontWeight="Bold"
                  Foreground="Black" />
          <Button Content="Pay"
                  Command="{Binding PayCommand}"
                  Background="#4CAF50"
                  CornerRadius="5"
                  Foreground="White"
                  Padding="30,10" />
        </StackPanel>

      </Grid>
    </Border>

    <ScrollViewer Margin="40">
      <StackPanel Spacing="20">
        <TextBlock Text="Order review"
                   FontSize="32"
                   FontWeight="Black"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- Infos du cabinet -->
        <Border Background="White" Padding="15" CornerRadius="10"
                BoxShadow="0 2 5 0 #20000000">
          <StackPanel Spacing="4">
            <TextBlock Text="Cabinet configuration" FontWeight="Bold" FontSize="16"/>
            <TextBlock Text="{Binding Cabinet.Width, StringFormat='Width: {0} cm'}" Foreground="Gray"/>
            <TextBlock Text="{Binding Cabinet.Depth, StringFormat='Depth: {0} cm'}" Foreground="Gray"/>
            <TextBlock Text="{Binding Cabinet.AngleIronColor, StringFormat='Angle Iron: {0}'}" Foreground="Gray"/>
          </StackPanel>
        </Border>

        <TextBlock Text="Lockers" FontSize="20" FontWeight="Bold"/>

        <ItemsControl ItemsSource="{Binding FinalLockers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Locker">
              <Border Background="White"
                      Margin="0,5"
                      Padding="15"
                      CornerRadius="10"
                      BoxShadow="0 2 5 0 #20000000">
                <StackPanel>
                  <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"/>
                  <TextBlock Text="{Binding Height, StringFormat='Height: {0} cm'}"
                             FontSize="12" Foreground="Gray"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Separator Height="2" Background="#B9CBA5" Margin="0,20"/>

        <TextBlock Text="Total lockers :"
                   FontSize="18"
                   HorizontalAlignment="Right"/>
        <TextBlock Text="{Binding FinalLockers.Count}"
                   FontSize="28"
                   FontWeight="Black"
                   HorizontalAlignment="Right"
                   Foreground="#3da442"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
