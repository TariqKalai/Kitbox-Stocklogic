<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Stocklogic.ViewModels"
             xmlns:models="using:Stocklogic.Models"
             x:Class="Stocklogic.Views.SummaryPage"
             x:DataType="vm:SummaryPageViewModel"
             Background="#F1F8E9">

  <DockPanel LastChildFill="True">
    <Border Height="60"
            Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
      <StackPanel Margin="0,0,20,0"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Orientation="Horizontal">
        <Button Content="Continue Shopping"
                Command="{Binding ContinueShoppingCommand}"
                Margin="0,0,20,0"
                Background="Transparent"
                FontWeight="Bold"
                Foreground="Black" />
        <Button Content="Pay"
                Command="{Binding PayCommand}"
                Background="#4CAF50"
                CornerRadius="5"
                Foreground="White"
                Padding="30,10" />
      </StackPanel>
    </Border>

    <ScrollViewer Margin="40">
      <StackPanel Spacing="20">
        <TextBlock Text="Order review"
                   FontSize="32"
                   FontWeight="Black"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- Infos du cabinet -->
        <Border Background="White" Padding="15" CornerRadius="10"
                BoxShadow="0 2 5 0 #20000000">
          <StackPanel Spacing="4">
            <TextBlock Text="Cabinet configuration" FontWeight="Bold" FontSize="16"/>
            <TextBlock Text="{Binding Cabinet.Width, StringFormat='Width: {0} cm'}" Foreground="Gray"/>
            <TextBlock Text="{Binding Cabinet.Depth, StringFormat='Depth: {0} cm'}" Foreground="Gray"/>
            <TextBlock Text="{Binding Cabinet.AngleIronColor, StringFormat='Angle Iron: {0}'}" Foreground="Gray"/>
          </StackPanel>
        </Border>

        <TextBlock Text="Lockers" FontSize="20" FontWeight="Bold"/>

        <ItemsControl ItemsSource="{Binding FinalLockers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Locker">
              <Border Background="White"
                      Margin="0,5"
                      Padding="15"
                      CornerRadius="10"
                      BoxShadow="0 2 5 0 #20000000">
                <StackPanel>
                  <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"/>
                  <TextBlock Text="{Binding Height, StringFormat='Height: {0} cm'}"
                             FontSize="12" Foreground="Gray"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Separator Height="2" Background="#B9CBA5" Margin="0,20"/>

        <TextBlock Text="Total lockers :"
                   FontSize="18"
                   HorizontalAlignment="Right"/>
        <TextBlock Text="{Binding FinalLockers.Count}"
                   FontSize="28"
                   FontWeight="Black"
                   HorizontalAlignment="Right"
                   Foreground="#2E7D32"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
